{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "MyDB": { "Type": "AWS::RDS::DBInstance", "Properties": { "Engine": "postgres", "StorageEncrypted": false, "PubliclyAccessible": true } },
    "MyVolume": { "Type": "AWS::EC2::Volume", "Properties": { "Size": 100, "AvailabilityZone": "us-east-1a", "Encrypted": false } },
    "MySG": { "Type": "AWS::EC2::SecurityGroup", "Properties": { "GroupDescription": "web", "SecurityGroupIngress": [ { "IpProtocol": "tcp", "FromPort": 22, "ToPort": 22, "CidrIp": "0.0.0.0/0" } ] } }
  }
}
